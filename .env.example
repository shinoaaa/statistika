# =====================================================================
# Konfigurasi Environment - Ruang Fokus (Studi Performa Kognitif)
# Salin file ini menjadi .env.local saat siap menghubungkan Neon DB
# =====================================================================

# 1. Neon Postgres Connection String (isi nanti di akhir dari dashboard Neon)
# Selama kosong, web otomatis menyimpan hasil tes ke file lokal (.local-data/submissions.json)
DATABASE_URL=

# 2. Passkey / Kunci Admin untuk halaman /admin dan ekspor CSV (/api/export)
# Isi nanti di akhir bersama Neon DB (atau bisa disimpan di tabel admin_passkeys Neon)
ADMIN_PASSKEY=

# 3. Opsional: Jamendo API Client ID (jika ingin menambah katalog Jamendo native vocal/instrumental)
# Tanpa ini pun katalog lagu sudah jalan otomatis lewat Audius Public Discovery API (tanpa API key)
JAMENDO_CLIENT_ID=
